<%- include('partials/header') %>
    <main>
        <h1>
            <%= title %>
        </h1>
        <p>Here are a few of our partner organizations:</p>

        <ul class="org-list">
            <% organizations.forEach(organization=> { %>
                <li class="org-item">
                    <img class="org-logo" src="/images/<%= organization.logo_filename %>"
                        alt="<%= organization.name %> logo">

                    <div class="org-info">
                        <h3>
                            <a href="/organization/<%= organization.organization_id %>">
                                <%= organization.name %>
                            </a>
                        </h3>
                        <p><strong>Email:</strong>
                            <%= organization.contact_email %>
                        </p>
                    </div>
                </li>
                <% }); %>
        </ul>

        <% if (user && user.role_name==='admin' ) { %>
            <a href="/new-organization" class="btn btn-admin">Add New Organization</a>
            <% } %>
    </main>
    <%- include('partials/footer') %>