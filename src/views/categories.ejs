<%- include('partials/header') %>

    <main>
        <h1>
            <%= title %>
        </h1>

        <% if (user && user.role_name==='admin' ) { %>
            <div class="actions-container">
                <a href="/new-category" class="btn-add-category">+ Add New Category</a>
            </div>
            <% } %>

                <h2>Project Categories</h2>
                <p>Please explore the various types of service projects available in our network:</p>

                <ul class="categories-list">
                    <% if (categories && categories.length> 0) { %>
                        <% categories.forEach(category=> { %>
                            <li class="category-item">
                                <a href="/category/<%= category.category_id %>" class="category-link">
                                    <span class="category-name">
                                        <%= category.name %>
                                    </span>
                                </a>

                                <div class="category-actions">
                                    <% if (user && user.role_name==='admin' ) { %>
                                        <a href="/edit-category/<%= category.category_id %>" class="btn-edit-category">
                                            ✏️ Edit
                                        </a>
                                        <% } else { %>
                                            <span class="category-arrow">→</span>
                                            <% } %>
                                </div>
                            </li>
                            <% }); %>
                                <% } else { %>
                                    <li class="no-categories">No categories found.</li>
                                    <% } %>
                </ul>
    </main>

    <%- include('partials/footer') %>