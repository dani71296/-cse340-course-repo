<%- include('partials/header') %>

    <main>
        <h1>
            <%= title %>
        </h1>

        <% if (user && user.role_name==='admin' ) { %>
            <div class="actions-container">
                <a href="/new-category" class="btn btn-primary">+ Add New Category</a>
            </div>
            <% } %>

                <h2>Project Categories</h2>
                <p>Please explore the various types of service projects available in our network:</p>

                <ul class="categories-list">
                    <% if (categories && categories.length> 0) { %>
                        <% categories.forEach(category=> { %>
                            <li>
                                <a href="/category/<%= category.category_id %>">
                                    <%= category.name %>
                                </a>

                                <% if (user && user.role_name==='admin' ) { %>
                                    <span style="margin-left: 10px;">
                                        <a href="/edit-category/<%= category.category_id %>"
                                            style="text-decoration: none; font-size: 0.85em; color: #007bff; font-weight: bold;">
                                            ✏️ Edit
                                        </a>
                                    </span>
                                    <% } %>
                            </li>
                            <% }); %>
                                <% } else { %>
                                    <li>No categories found.</li>
                                    <% } %>
                </ul>
    </main>

    <%- include('partials/footer') %>