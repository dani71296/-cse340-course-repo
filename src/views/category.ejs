<%- include('partials/header') %>

    <main>
        <h1>
            <%= title %>
        </h1>

        <h2>Service Projects</h2>
        <p>Explore projects belonging to this category:</p>

        <ul class="projects-list">
            <% if (projects && projects.length> 0) { %>
                <% projects.forEach(project=> { %>
                    <li>
                        <a href="/project/<%= project.project_id %>">
                            <%= project.title %>
                        </a>
                        <span>
                            by <a href="/organization/<%= project.organization_id %>">
                                <%= project.organization_name %>
                            </a>
                        </span>
                    </li>
                    <% }); %>
                        <% } else { %>
                            <li>No projects found for this category.</li>
                            <% } %>
        </ul>

        <p style="margin-top: 25px;"><a href="/categories">← Back to All Categories</a></p>
        <a href="/edit-category/<%= category.category_id %>" class="btn btn-edit">Edit Category</a>
    </main>

    <%- include('partials/footer') %>