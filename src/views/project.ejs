<%- include('partials/header') %>
    <main>
        <h1>
            <%= project.title %>
        </h1>

        <p class="project-tags" style="margin-bottom: 20px;">
            <strong>Categories:</strong>
            <% if (categories && categories.length> 0) { %>
                <% categories.forEach(category=> { %>
                    <span class="category-tag"
                        style="margin-right: 8px; background-color: #f0f4f8; padding: 4px 10px; border-radius: 4px; border: 1px solid #d1e2ff; display: inline-block;">
                        <a href="/category/<%= category.category_id %>"
                            style="text-decoration: none; color: #0056b3; font-weight: bold; font-size: 0.9em;">
                            <%= category.name %>
                        </a>
                    </span>
                    <% }); %>
                        <% } else { %>
                            <span style="color: #666; font-style: italic;">None</span>
                            <% } %>
        </p>
        <p><strong>Description:</strong>
            <%= project.description %>
        </p>

        <p><strong>Date:</strong>
            <%= new Date(project.project_date).toLocaleDateString('en-US', { weekday: 'long' , month: 'long' ,
                day: 'numeric' , year: 'numeric' }) %>
        </p>

        <p><strong>Location:</strong>
            <%= project.location %>
        </p>

        <p><strong>Partner Organization:</strong>
            <a href="/organization/<%= project.organization_id %>">
                <%= project.organization_name %>
            </a>
        </p>

        <p><a href="/projects">← Back to Upcoming Projects</a></p>
    </main>
    <%- include('partials/footer') %>