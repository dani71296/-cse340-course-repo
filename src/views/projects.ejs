<%- include('partials/header') %>
    <main>
        <% if (user && user.role_name==='admin' ) { %>
            <p>
                <a href="/new-project" class="btn-add-project">
                    ➕ Add a New Service Project
                </a>
            </p>
            <% } %>

                <h1>
                    <%= title %>
                </h1>

                <ul class="projects-grid">
                    <% if (projects && projects.length> 0) { %>
                        <% projects.forEach(project=> { %>
                            <li class="project-card-item">

                                <div class="project-date-badge">
                                    <span class="project-date-text">
                                        <%= new Date(project.project_date).toLocaleDateString('en-US', { month: 'short'
                                            , day: 'numeric' , year: 'numeric' }) %>
                                    </span>
                                </div>

                                <div class="project-card-content">
                                    <h3>
                                        <a href="/project/<%= project.project_id %>">
                                            <%= project.title %>
                                        </a>
                                    </h3>
                                    <p class="project-card-org">
                                        Partnered with:
                                        <a href="/organization/<%= project.organization_id %>">
                                            <%= project.organization_name %>
                                        </a>
                                    </p>
                                </div>

                                <% if (user && user.role_name==='admin' ) { %>
                                    <div class="project-card-admin-actions">
                                        <a href="/assign-categories/<%= project.project_id %>"
                                            class="btn-edit-categories">
                                            ✏️ Categories
                                        </a>
                                    </div>
                                    <% } else { %>
                                        <span class="project-card-arrow">→</span>
                                        <% } %>

                            </li>
                            <% }); %>
                                <% } else { %>
                                    <li class="no-projects">No upcoming service projects available at the moment.</li>
                                    <% } %>
                </ul>
    </main>
    <%- include('partials/footer') %>