<%- include('partials/header') %>

    <main class="container">
        <h1>
            <%= title %>
        </h1>

        <% if (messages && messages.error) { %>
            <div class="alert alert-danger">
                <% messages.error.forEach(function(msg) { %>
                    <p>
                        <%= msg %>
                    </p>
                    <% }) %>
            </div>
            <% } %>

                <form action="/edit-project/<%= project.project_id %>" method="POST" class="form-box">

                    <div class="form-group">
                        <label for="title">Project Title:</label>
                        <input type="text" id="title" name="title" value="<%= project.title %>" required
                            maxlength="200">
                    </div>

                    <div class="form-group">
                        <label for="description">Description:</label>
                        <textarea id="description" name="description" required
                            maxlength="1000"><%= project.description %></textarea>
                    </div>

                    <div class="form-group">
                        <label for="location">Location:</label>
                        <input type="text" id="location" name="location" value="<%= project.location %>" required
                            maxlength="200">
                    </div>

                    <div class="form-group">
                        <label for="date">Date:</label>
                        <% // Formateamos de forma segura la fecha para el input HTML5 (YYYY-MM-DD) %>
                            <% const formattedDate=project.project_date ? new
                                Date(project.project_date).toISOString().split('T')[0] : '' ; %>
                                <input type="date" id="date" name="date" value="<%= formattedDate %>" required>
                    </div>

                    <div class="form-group">
                        <label for="organizationId">Organization:</label>
                        <select id="organizationId" name="organizationId" required>
                            <% organizations.forEach(org=> { %>
                                <option value="<%= org.organization_id %>"
                                    <%=org.organization_id===project.organization_id ? 'selected' : '' %>>
                                    <%= org.name %>
                                </option>
                                <% }) %>
                        </select>
                    </div>

                    <button type="submit" class="btn-submit">Update Project</button>
                </form>
    </main>

    <%- include('partials/footer') %>